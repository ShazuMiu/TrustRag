# ===========================================================================
# TrustRAG v2 — .gitignore
# Note: a "#" only starts a comment at the START of a line.
# Never put a comment at the end of a pattern line.
# ===========================================================================

# ---------------------------------------------------------------------------
# Secrets — NEVER commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets.yaml
credentials.json

# ---------------------------------------------------------------------------
# TrustRAG generated output
# indexes/  rebuild with:  python -m trustrag.cli ingest --input <folder>
# logs/     SQLite audit log
# results/  benchmark runs; the two sample reports below stay in the repo
# ---------------------------------------------------------------------------
indexes/
logs/
results/*/
!results/demo_lite/
!results/demo_mock_llm/

# Large artifacts if you build an index outside indexes/ via --index
*.faiss
*.npy
*.pkl

# Downloaded model caches, if ever pointed inside the project
.cache/
hf_cache/
models/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.virtualenv/

# Testing, coverage, linting, type checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.dmypy.json
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# IDEs and editors
# PyCharm: .idea/ holds machine-specific interpreter paths, so it is ignored
# wholesale. To share run configurations with teammates, delete the .idea/
# line and uncomment the finer-grained rules below it.
# ---------------------------------------------------------------------------
.idea/
# .idea/workspace.xml
# .idea/tasks.xml
# .idea/usage.statistics.xml
# .idea/shelf/
# .idea/*.iml

.vscode/
*.code-workspace
*.swp
*.swo
*~
*.sublime-workspace

# ---------------------------------------------------------------------------
# Operating system
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak
tmp/
scratch/